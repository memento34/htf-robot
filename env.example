# Create these in Railway Variables. Never commit actual keys.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_POSITION_MODE=net
# Set true only after creating a Railway volume mounted at /data.
BOT_ENABLED=false
BOT_DB=/data/bot.sqlite3
PAPER_TEST_DAYS=30
SCAN_INTERVAL_SECONDS=60
MAX_SYMBOLS_PER_CYCLE=40
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2
MAX_TOTAL_NOTIONAL_PCT=30
MIN_24H_VOLUME_USDT=1000000
FEE_BPS=5
SLIPPAGE_BPS=3

